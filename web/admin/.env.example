# Public URL used by the Next.js admin application
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Backend API base (no trailing /api/v1 - client adds it).
# Local: http://localhost:4000 | Server: https://your-api-domain
# When set, admin calls real API with Bearer JWT from POST /auth/login.
# When empty, admin uses in-memory mock so UI keeps working.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Admin session values for the future authenticated admin flow
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-a-local-secret
