# Public URL used by the Next.js user web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base (no trailing /api/v1 - client adds it).
# Local: http://localhost:4000 | Server: https://your-api-domain
# When set, frontend calls real API (GET /content/published, POST /auth/login...).
# When empty, it falls back to local demoData so old landing keeps serving.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# NextAuth values for the future authenticated member flow
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-local-secret
