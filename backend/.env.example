# ---- Core ----
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
APP_URL=http://localhost:4000
USER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
SWAGGER_ENABLED=true

# ---- Database (Neon PostgreSQL production / local Postgres dev) ----
# Neon example: postgresql://user:password@ep-xxx.neon.tech/asaphis?sslmode=require
DATABASE_URL=postgresql://asaphis:asaphis@localhost:5432/asaphis?schema=public
DIRECT_URL=postgresql://asaphis:asaphis@localhost:5432/asaphis?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=asaphis

# ---- Auth / Sessions ----
JWT_ACCESS_SECRET=replace-with-32plus-char-access-secret
JWT_REFRESH_SECRET=replace-with-32plus-char-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=
COOKIE_SECURE=false
ADMIN_MFA_REQUIRED=true
BCRYPT_ROUNDS=12

# ---- Phone verification (provider-independent) ----
# Primary/fallback selectable per country: mock | twilio | termii | africa-talking | whatsapp-cloud
PHONE_PRIMARY_PROVIDER=mock
PHONE_FALLBACK_PROVIDER=mock
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_LENGTH=6
PHONE_MAX_ATTEMPTS=5
PHONE_RESEND_COOLDOWN_SECONDS=60
PHONE_RATE_LIMIT_PER_HOUR=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TERMII_API_KEY=
TERMII_SENDER_ID=AsaPhis
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# ---- Identity / KYC (multi-provider interface, mock by default) ----
IDENTITY_PRIMARY_PROVIDER=mock
IDENTITY_FALLBACK_PROVIDER=
# smile | onfido | veriff | smile-id | dojah
SMILE_PARTNER_ID=
SMILE_API_KEY=
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
ONFIDO_API_TOKEN=
VERIFF_API_TOKEN=

# ---- IP intelligence / geolocation ----
IP_INTEL_PROVIDER=mock
# maxmind | ipinfo | ipapi
MAXMIND_DB_PATH=./geo/GeoLite2-Country.mmdb
IPINFO_TOKEN=

# ---- Africa access policy defaults ----
AFRICA_ONLY_MEMBERS=false
ALLOWED_MEMBER_COUNTRIES=NG,GH,KE,ZA,ZM,RW,SN,CM,ET,TZ,UG,ZW,BW,NA,MZ,ML,CI,SL,LR,GM,TG,BJ,NE,BF,MR,TD,CG,CD,GA,GQ,AO,SZ,LS,MW,BI,DJ,SO,SD,SS,ER,LY,TN,DZ,MA,EG,MU,SC,CV,ST,KM
EMERGENCY_ACCESS_ENABLED=false

# ---- Payments (country-aware, secrets server-side only) ----
PAYMENT_DEFAULT_CURRENCY=NGN
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=

# ---- Object storage (S3-compatible) ----
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=asaphis-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
FILE_MAX_MB=25
IDENTITY_DOC_MAX_MB=10
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_ENDPOINT=

# ---- Email / SMS notifications ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@asaphis.org
SMS_ALERTS_ENABLED=false

# ---- Official external community links (overridable in Admin settings) ----
WHATSAPP_COMMUNITY_URL=https://wa.me/2348012345678
TELEGRAM_COMMUNITY_URL=https://t.me/asaphis

# ---- Feature flags (seed defaults; Admin can toggle without redeploy) ----
FF_MEMBER_CHAT=false
FF_TRUSTED_MEMBER_AUTO_PUBLISH=false
FF_TRAVEL_ACCESS=true
FF_PUSH_NOTIFICATIONS=false
FF_WHATSAPP_NOTIFICATIONS=false
FF_NEW_VERIFICATION_PROVIDER=false
FF_NEW_PAYMENT_PROVIDER=false

# ---- Seed admin ----
SEED_ADMIN_EMAIL=admin@asaphis.org
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=AsaPhis Admin
